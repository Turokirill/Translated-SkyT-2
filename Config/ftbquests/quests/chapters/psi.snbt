							}
						}
					}
					type: "item"
				}
			]
			tasks: [{
				id: "4748D06BCF5A4839"
				item: "psi:lit_black_psimetal_plate"
				type: "item"
			}]
			x: 9.5d
			y: 6.5d
		}
		{
			description: [
				"Psi — это мод программирования магических технических заклинаний, вдохновленный Махоукой. Не беспокойтесь, если это не имеет никакого смысла"
				""
				"Ядро Psi — это система, в которой вы можете создавать последовательности действий («Заклинания») для выполнения в мире."
				""
				"За этой системой следует система уровней, содержащая внутриигровую документацию и учебные пособия по различным концепциям и частям, которые вы получите. Мод использует в своих системах базовые математические концепции, такие как векторы, что обеспечивает большую гибкость в отношении того, что заклинания могут делать"
			]
			icon: {
				Count: 1b
				id: "patchouli:guide_book"
				tag: {
					"patchouli:book": "psi:encyclopaedia_psionica"
				}
